```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
library(Hmisc)
library(dplyr)
```


```{r}
getHdata(rhc)
rhc_data <- rhc

df <- rhc_data %>%
  mutate(
    A = ifelse(swang1 == "RHC", 1, 0),
    
    Y = ifelse(death == "Yes", 1, 0),
    
    cat1 = as.factor(cat1),
    chfhx = as.factor(chfhx),
    dnr1 = as.factor(dnr1)
  ) %>%
  
  dplyr::select(A, Y, cat1, pafi1, age, meanbp1, chfhx, scoma1, aps1, dnr1)

df <- na.omit(df)
```

```{r}
set.seed(2026)

K <- 5
n <- nrow(df)
folds <- sample(rep(1:K, length.out = n))
scores <- numeric(n)

covariates <- "aps1 + chfhx + dnr1 + meanbp1"

out_formula <- as.formula(paste("Y ~ A * (", covariates, ")"))
ps_formula <- as.formula(paste("A ~", covariates))

for (k in 1:K) {
  
  train <- df[folds != k, ]
  test  <- df[folds == k, ]

  fit_y <- glm(out_formula, data = train, family = binomial)
  

  mu1_k <- predict(fit_y, newdata = transform(test, A = 1), type = "response")
  mu0_k <- predict(fit_y, newdata = transform(test, A = 0), type = "response")
  

  fit_ps <- glm(ps_formula, data = train, family = binomial)
  ps_k <- predict(fit_ps, newdata = test, type = "response")
  

  ps_k <- pmin(pmax(ps_k, 0.02), 0.98) 
  
 
  A_k <- test$A
  Y_k <- test$Y
  
  
  scores[folds == k] <- (mu1_k - mu0_k) + 
                        (A_k * (Y_k - mu1_k) / ps_k) - 
                        ((1 - A_k) * (Y_k - mu0_k) / (1 - ps_k))
}


tau_dml <- mean(scores)
se_dml <- sd(scores) / sqrt(n)
ci_lower <- tau_dml - 1.96 * se_dml
ci_upper <- tau_dml + 1.96 * se_dml

cat("Cross-fitted AIPW (DML) Estimate of RHC on Mortality:\n")
cat("-----------------------------------------------------\n")
cat(sprintf("ATE Estimate:  %.4f\n", tau_dml))
cat(sprintf("Standard Err:  %.4f\n", se_dml))
cat(sprintf("95%% CI:        [%.4f, %.4f]\n", ci_lower, ci_upper))
```


